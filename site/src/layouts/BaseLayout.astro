---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description: string;
  active?: 'feed' | 'search' | 'papers';
}

const { title, description, active = 'feed' } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#173f3a" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to results</a>
    <SiteHeader active={active} />
    <main id="main-content"><slot /></main>
    <footer class="site-footer"><span>ASR-TTS Paper Daily</span><span>Static archive, updated twice daily</span></footer>
  </body>
</html>