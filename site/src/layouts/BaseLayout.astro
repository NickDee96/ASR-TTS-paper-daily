---
import '../styles/global.css';
import ReaderVisitTracker from '../components/ReaderVisitTracker';
import SiteHeader from '../components/SiteHeader.astro';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description: string;
  active?: 'feed' | 'search' | 'papers' | 'bookmarks' | 'status';
  ogType?: 'website' | 'article';
}

const { title, description, active = 'feed', ogType = 'website' } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const serviceWorkerPath = withBase('/sw.js');
const serviceWorkerScope = withBase('/');
const manifestUrl = withBase('/data/manifest.json');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#173f3a" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/atom+xml" title="ASR-TTS Paper Daily" href={withBase('/data/feeds/all.xml')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta name="twitter:card" content="summary" />
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body>
    <ReaderVisitTracker client:only="react" manifestUrl={manifestUrl} />
    <a class="skip-link" href="#main-content">Skip to results</a>
    <SiteHeader active={active} />
    <main id="main-content"><slot /></main>
    <footer class="site-footer"><span>ASR-TTS Paper Daily</span><span>Static archive, updated twice daily</span></footer>
    <script is:inline define:vars={{ serviceWorkerPath, serviceWorkerScope }}>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register(serviceWorkerPath, { scope: serviceWorkerScope }).catch(() => {});
        }, { once: true });
      }
    </script>
  </body>
</html>