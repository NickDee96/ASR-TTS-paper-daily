---
import BaseLayout from '../layouts/BaseLayout.astro';
import PaperRow from '../components/PaperRow.astro';
import SearchFallback from '../components/SearchFallback.astro';
import SearchToolbar from '../components/SearchToolbar';
import TopicNav from '../components/TopicNav.astro';
import { previewPapers } from '../data/preview-papers';
import { withBase } from '../lib/paths';
---

<BaseLayout title="Search papers | ASR-TTS Paper Daily" description="Search speech and language research papers." active="search">
  <div class="page-shell">
    <section class="workspace-heading" aria-labelledby="page-title">
      <div><p class="eyebrow">Archive search</p><h1 id="page-title">Find a paper</h1><p id="search-context">Search across the current paper archive.</p></div>
      <dl class="archive-metrics"><div><dt>Matches</dt><dd id="search-match-count">{previewPapers.length}</dd></div><div><dt>Scope</dt><dd id="search-scope">All</dd></div></dl>
    </section>
    <SearchToolbar client:only="react" action={withBase('/search/')}>
      <SearchFallback slot="fallback" action={withBase('/search/')} />
    </SearchToolbar>
    <div class="results-layout">
      <TopicNav />
      <section aria-labelledby="results-heading">
        <div class="results-heading"><h2 id="results-heading">Search results</h2><p id="search-result-summary" aria-live="polite">{previewPapers.length} papers</p></div>
        <div class="paper-list" id="search-results">{previewPapers.map((paper, index) => <PaperRow paper={paper} index={index} />)}</div>
        <div class="empty-state" id="search-empty" hidden><h2>No matching papers</h2><p>Try a broader term or clear the active topic.</p></div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  const parameters = new URLSearchParams(window.location.search);
  const query = (parameters.get('q') ?? '').trim();
  const normalizedQuery = query.toLocaleLowerCase();
  const topic = (parameters.get('topic') ?? '').trim();
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-paper-row]'));
  let matches = 0;

  for (const row of rows) {
    const topics = (row.dataset.topics ?? '').split('|');
    const matchesQuery = !normalizedQuery || (row.dataset.searchIndex ?? '').includes(normalizedQuery);
    const matchesTopic = !topic || topics.includes(topic);
    row.hidden = !(matchesQuery && matchesTopic);
    if (!row.hidden) matches += 1;
  }

  const context = [query && `"${query}"`, topic].filter(Boolean).join(' in ');
  const contextElement = document.querySelector('#search-context');
  const countElement = document.querySelector('#search-match-count');
  const scopeElement = document.querySelector('#search-scope');
  const summaryElement = document.querySelector('#search-result-summary');
  const resultList = document.querySelector<HTMLElement>('#search-results');
  const emptyState = document.querySelector<HTMLElement>('#search-empty');
  if (contextElement) contextElement.textContent = context ? `Results for ${context}.` : 'Search across the current paper archive.';
  if (countElement) countElement.textContent = String(matches);
  if (scopeElement) scopeElement.textContent = topic || 'All';
  if (summaryElement) summaryElement.textContent = `${matches} ${matches === 1 ? 'paper' : 'papers'}`;
  if (resultList) resultList.hidden = matches === 0;
  if (emptyState) emptyState.hidden = matches !== 0;

  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-topic-link]')) {
    const linkTopic = link.dataset.topic ?? '';
    const linkParameters = new URLSearchParams();
    if (query) linkParameters.set('q', query);
    linkParameters.set('topic', linkTopic);
    link.search = linkParameters.toString();
    const active = linkTopic === topic;
    link.classList.toggle('active', active);
    if (active) link.setAttribute('aria-current', 'true');
    else link.removeAttribute('aria-current');
  }

  const clearLink = document.querySelector<HTMLAnchorElement>('.topic-clear');
  if (clearLink) {
    const clearParameters = new URLSearchParams();
    if (query) clearParameters.set('q', query);
    clearLink.search = clearParameters.toString();
    clearLink.hidden = !topic;
  }
</script>