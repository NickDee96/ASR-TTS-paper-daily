---
import BaseLayout from '../layouts/BaseLayout.astro';
import PagefindResults from '../components/PagefindResults';
import SearchFallback from '../components/SearchFallback.astro';
import SearchToolbar from '../components/SearchToolbar';
import TopicNav from '../components/TopicNav.astro';
import { loadArchiveSummary } from '../data/papers';
import { withBase } from '../lib/paths';

const archiveSummary = loadArchiveSummary();
---

<BaseLayout title="Search papers | ASR-TTS Paper Daily" description="Search speech and language research papers." active="search">
  <div class="page-shell">
    <section class="workspace-heading" aria-labelledby="page-title">
      <div><p class="eyebrow">Archive search</p><h1 id="page-title">Find a paper</h1><p>Search titles, abstracts, authors, arXiv IDs, and curated topics.</p></div>
      <dl class="archive-metrics"><div><dt>Indexed</dt><dd>{archiveSummary.uniquePapers.toLocaleString('en-US')}</dd></div><div><dt>Batch size</dt><dd>25</dd></div></dl>
    </section>
    <SearchToolbar client:only="react" action={withBase('/search/')}>
      <SearchFallback slot="fallback" action={withBase('/search/')} />
    </SearchToolbar>
    <div class="results-layout">
      <TopicNav />
      <section aria-labelledby="results-heading">
        <PagefindResults
          client:only="react"
          baseUrl={withBase('/')}
          bundlePath={withBase('/pagefind/')}
          updatedAt={archiveSummary.updatedAt}
        >
          <div slot="fallback" class="search-state" role="status">Loading the paper index...</div>
        </PagefindResults>
      </section>
    </div>
  </div>
</BaseLayout>
<!-- Search results hydrate from the generated Pagefind index. -->
