---
import { withBase } from '../lib/paths';
import { loadArchiveSummary } from '../data/papers';

interface Props {
  active?: 'feed' | 'search' | 'papers' | 'bookmarks';
}

const { active = 'feed' } = Astro.props;
const updatedAt = loadArchiveSummary().updatedAt;
const updatedLabel = new Intl.DateTimeFormat('en', {
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
}).format(new Date(updatedAt));
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={withBase('/')} aria-label="ASR-TTS Paper Daily home">
      <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
      <span><strong>ASR-TTS</strong><small>Paper Daily</small></span>
    </a>
    <nav aria-label="Primary navigation">
      <a class:list={[{ active: active === 'feed' }]} href={withBase('/')}>Feed</a>
      <a class:list={[{ active: active === 'search' }]} href={withBase('/search/')}>Search</a>
      <a class:list={[{ active: active === 'bookmarks' }]} href={withBase('/bookmarks/')}>Bookmarks</a>
      <a class:list={[{ active: active === 'papers' }]} href={withBase('/papers/2607.18064/')}>Paper</a>
    </nav>
    <div class="freshness" title={`Last successful archive update: ${updatedAt}`}><span aria-hidden="true"></span>Updated {updatedLabel}</div>
  </div>
</header>