{
  "name": "asr-tts-paper-explorer",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prepare:data": "python ../prepare_site_content.py",
    "build:astro": "astro build",
    "build:index": "pagefind --site dist --output-subdir pagefind",
    "build:offline": "python ../generate_service_worker.py",
    "verify:build": "python ../verify_site_build.py",
    "build": "npm run prepare:data && npm run build:astro && npm run build:index && npm run build:offline && npm run verify:build",
    "check": "astro check",
    "test:unit": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@fluentui/react-components": "^9.74.4",
    "astro": "7.1.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3"
  }
}
